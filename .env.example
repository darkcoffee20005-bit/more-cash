# رابط MongoDB. اتركه فارغاً للتجربة بتخزين ملف محلي (لا يُنصح به للعمل الفعلي)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=morecash
PORT=3000
HOST=0.0.0.0
# سر إضافي لرموز الموظفين — نص عشوائي طويل. لا تغيّره بعد الإعداد وإلا بطلت كل الرموز
PIN_PEPPER=
# فعّلها عند التشغيل خلف HTTPS / وكيل عكسي
COOKIE_SECURE=false
TRUST_PROXY=false

# مفتاح Claude API لقراءة صور فواتير المشتريات (اختياري؛ الإدخال اليدوي يعمل بدونه)
ANTHROPIC_API_KEY=
